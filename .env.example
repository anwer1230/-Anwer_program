# ===================================================
  # مركز سرعة انجاز — متغيرات البيئة المطلوبة
  # انسخ هذا الملف وأعد تسميته .env وضع قيمك الحقيقية
  # ===================================================

  # مفتاح تشفير الجلسات (أي نص عشوائي طويل)
  SESSION_SECRET=your-secret-key-here

  # مفتاح Groq AI — احصل عليه مجاناً من https://console.groq.com
  # يُستخدم في: التحليل الأكاديمي الذكي + إنشاء العروض التقديمية
  GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

  # على Render فقط — يُفعّل تخزين الجلسات في /tmp
  RENDER=true
  